APP_NAME=Брайт
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Local development:
APP_BASE_URL=http://localhost:8000
# Telegram WebApp requires HTTPS in production. Example:
# PUBLIC_DOMAIN=orders.example.com
# APP_BASE_URL=https://orders.example.com
# TELEGRAM_WEBAPP_BASE_URL=https://orders.example.com
PUBLIC_DOMAIN=localhost
LOG_LEVEL=INFO

POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery
DATABASE_URL=postgresql+psycopg://delivery:delivery@postgres:5432/delivery

# Host ports. Change these if 8000 or 5432 are already taken on the server.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_BASE_URL=
# Comma-separated Telegram user ids of staff who receive orders and change statuses.
# Empty — nobody gets orders in Telegram (the panel still works).
TELEGRAM_ALLOWED_USER_IDS=

DASHBOARD_SECRET_KEY=change-me-dashboard-secret
DASHBOARD_COOKIE_NAME=delivery_dashboard_session
DASHBOARD_BOOTSTRAP_USERNAME=admin
DASHBOARD_BOOTSTRAP_PASSWORD=change-me
DASHBOARD_BOOTSTRAP_ROLE=admin

# Customer sign-in. Separate signing key for customer tokens (defaults to one derived from DASHBOARD_SECRET_KEY).
CUSTOMER_JWT_SECRET=
# SMS codes: "log" prints the code to the api log (development), "smsru" sends through sms.ru.
SMS_PROVIDER=log
SMSRU_API_ID=
# Development only: return the SMS code in the API response. Ignored when APP_ENV=production.
OTP_DEBUG=false

# Address search. With a key — Yandex Geocoder (recommended); without — Photon (OpenStreetMap).
YANDEX_GEOCODER_API_KEY=

# Fill an empty database with the venue, a delivery zone and the «Брайт» menu on first start.
SEED_DEMO_DATA=true

# Bonuses: "title:spend over 90 days:percent", and the share of an order bonuses may pay.
BONUS_LEVELS=Старт:0:3,Свой:5000:5,Друг:15000:7
BONUS_MAX_REDEEM_PERCENT=30

SUPPORT_PHONE=+7 (916) 498-39-09
# Older app builds see "Обновите приложение".
MIN_SUPPORTED_APP_VERSION=1.0.0
IOS_STORE_URL=
ANDROID_STORE_URL=
